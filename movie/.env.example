# cp .env.example .env 로 복사한 뒤 내 로컬 MySQL 정보로 바꿔 주세요. (.env 는 .gitignore 에 들어 있습니다)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=umc_movie
PORT=3000
# 브라우저에서 이 서버를 부를 수 있는 화면 주소(쉼표로 여러 개). 비우면 http://localhost:5173 만 허용한다.
CORS_ORIGINS=http://localhost:5173

# 7주차: JWT. 아래는 예시일 뿐 실제로 쓰면 안 된다. 32자 이상의 무작위 문자열로 바꿔서 .env 에 넣는다.
#   openssl rand -base64 48
JWT_SECRET=change-me-this-is-only-a-placeholder-never-use-it
# Access Token 유효시간(초). 3600 = 1시간
JWT_ACCESS_EXPIRATION=3600
