              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "pm.test('code COMMON201', () => pm.expect(pm.response.json().code).to.eql('COMMON201'));",
              "pm.test('favoriteId·movieId·createdAt 만 있다', () => pm.expect(Object.keys(pm.response.json().result)).to.eql(['favoriteId','movieId','createdAt']));",
              "pm.test('요청 Body 에 memberId 가 없다', () => pm.expect(JSON.parse(pm.request.body.raw)).to.not.have.property('memberId'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
